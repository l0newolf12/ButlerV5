<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ButlerV5</AssemblyName>
    <RootNamespace>ButlerV5</RootNamespace>
    <Version>1.2.5</Version>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <SkuaAssemblies>C:\Program Files\Skua\Assemblies</SkuaAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Skua.Core.Interfaces">
      <HintPath>$(SkuaAssemblies)\Skua.Core.Interfaces.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Skua.Core.Models">
      <HintPath>$(SkuaAssemblies)\Skua.Core.Models.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Skua.Core.Utils">
      <HintPath>$(SkuaAssemblies)\Skua.Core.Utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Skua.Core">
      <HintPath>$(SkuaAssemblies)\Skua.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Skua.WPF">
      <HintPath>$(SkuaAssemblies)\Skua.WPF.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
